# IBM watsonx.ai credentials
WATSONX_API_KEY=your-api-key-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-project-id-here

# Model to use
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Path to the repository Bob will analyse
# This path is relative to where uvicorn/Docker starts (the app root).
# The payment_demo repo is bundled inside the Docker image at this path.
REPO_PATH=./payment/IBM-bob-payment-demo
